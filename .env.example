# Скопируйте в /etc/claude-tg-bot.env, выполните chmod 600 и заполните три первых значения.
# Файл с настоящими значениями никуда не коммитьте.

# ── Обязательно ──
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш числовой Telegram ID (узнать: @userinfobot). Бот отвечает только этому пользователю.
TELEGRAM_OWNER_ID=
# Долгоживущий токен вашего аккаунта Claude: `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=

# ── По умолчанию (можно не менять) ──
PROJECTS_ROOT=/opt/projects
STATE_FILE=/var/lib/claude-tg-bot/state.json
CLAUDE_BIN=/usr/bin/claude
# Окно автосжатия беседы, токенов
CLAUDE_CODE_AUTO_COMPACT_WINDOW=200000

# Claude Code: без самообновления (обновляет root по таймеру) и без лишней телеметрии
DISABLE_AUTOUPDATER=1
DISABLE_TELEMETRY=1
DISABLE_ERROR_REPORTING=1
DISABLE_NON_ESSENTIAL_MODEL_CALLS=1
DISABLE_BUG_COMMAND=1

# ── Голосовой ввод (необязательно, см. README) ──
#STT_DIR=/var/lib/claude-tg-bot/stt
#WHISPER_LANG=ru     # auto — определять язык сам, на 4–5 с медленнее

# ── Перевод на английский (включён по умолчанию, см. README) ──
# Запросы идут к Claude по-английски: английский занимает меньше токенов. Бот переводит вашу реплику туда,
# а ответ обратно. По умолчанию переводит Haiku через Claude Code по вашей подписке: ключи не нужны.
# Если Claude Code переводчика не пускает, перевод выключается сам и бот работает по-русски, как раньше.
#TRANSLATE_BACKEND=off          # off — совсем без перевода; cli — Haiku по подписке (по умолчанию); api — только по ключу
#TRANSLATE_CLI_MODEL=           # пусто — Haiku 5.5 (бот сам выбирает имя под ваш Claude Code); или своя модель, например haiku
#TRANSLATE_MIN_MEM_MB=260       # меньше свободной памяти — переводчик на этот раз пропускается
# НЕ задавайте ANTHROPIC_API_KEY: Claude Code перешёл бы с подписки на оплату по API.

# ── Перевод через DeepSeek по ключу (необязательно: тогда тексты уходят третьему лицу) ──
# С ключом бот переводит им, пока не задан TRANSLATE_BACKEND=cli.
#DEEPSEEK_API_KEY=
#TRANSLATE_MODEL=deepseek-flash
#TRANSLATE_API_URL=https://api.deepseek.com/chat/completions
# Другой сервис (любой OpenAI-совместимый): его ключ кладите в TRANSLATE_API_KEY, он главнее DEEPSEEK_API_KEY
#TRANSLATE_API_KEY=
